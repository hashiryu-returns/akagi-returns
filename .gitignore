# ---------------------------------------------------------------------------
# Build output — all regenerable via `scripts/akagi setup`.
# ---------------------------------------------------------------------------
/target/
/frontend/dist/
/frontend/dist-ssr/
node_modules/
__pycache__/
*.py[cod]
*.rs.bk

# Tauri codegen (regenerated by tauri-build)
/gen/

# ---------------------------------------------------------------------------
# Runtime state. Local to this machine and often large; `scripts/akagi run`
# links these into target/debug/ so target/ stays disposable.
# ---------------------------------------------------------------------------

# CA key/cert, logs, game history, and the Chromium profiles (browser
# sessions). The CA private key and the profiles' cookies are credentials —
# never commit them, even to a private repo.
/data/

# Bundled python + uv, fetched by scripts/fetch-runtime.sh (~90 MB of binaries)
/runtime/*
!/runtime/.gitkeep

# Locally installed mjai bots: uv venvs plus multi-hundred-MB model weights,
# all managed by Akagi itself.
/mjai_bot/*
!/mjai_bot/.gitkeep

# ---------------------------------------------------------------------------
# Secrets. Nothing here should ever reach a remote, private or not.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
.direnv/
*.pem
*.key
*.p12
*.pfx
*.keystore
secrets.*
credentials.*
*.token

# WARNING: configs/ is deliberately tracked, because config.toml and delay.lua
# hold the tuned autoplay timings and those are the point of keeping a backup.
# The app writes that same tracked file, so anything you type into Settings
# lands in the working tree — including bot.api.key, which is a credential and
# has no untracked override. Check `git diff configs/` before committing.

# ---------------------------------------------------------------------------
# OS / editor / tooling noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*.swp
*.swo
*.sw?
*~
*.local
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.log
*.tmp
*.pid
*.orig
*.rej
*.bak

# ---------------------------------------------------------------------------
# Agent / assistant scratch. Anchored to the repo root so a source file that
# happens to be named `reference` or `agents.rs` isn't swallowed.
# ---------------------------------------------------------------------------
/.claude
/.agents
/.codex
/.cursor/
/.zcode/
/CLAUDE.md
/AGENTS.md
/claude*.md
/agent*.md
/reference
/reference*.md
*mcp.json
