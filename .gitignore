# ---------------------------------------------------------------------------
# Build output — all regenerable via `scripts/akagi setup`.
# ---------------------------------------------------------------------------
/target/
/frontend/dist/
node_modules/
__pycache__/
*.py[cod]

# Tauri codegen (regenerated by tauri-build)
/gen/

# ---------------------------------------------------------------------------
# Runtime state. Local to this machine and often large; `scripts/akagi run`
# links these into target/debug/ so target/ stays disposable.
# ---------------------------------------------------------------------------

# CA key/cert, logs, game history, and the Chromium profile (browser session).
# The CA private key and the profile's cookies are credentials — never commit
# them, even to a private repo.
/data/

# Bundled python + uv, fetched by scripts/fetch-runtime.sh (~90 MB of binaries)
/runtime/*
!/runtime/.gitkeep

# Locally installed mjai bots: uv venvs plus multi-hundred-MB model weights,
# all managed by Akagi itself.
/mjai_bot/*
!/mjai_bot/.gitkeep

# ---------------------------------------------------------------------------
# Secrets. Nothing here should ever reach a remote, private or not.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
secrets.*
credentials.*
*.token

# NOTE: configs/ is deliberately tracked — config.toml and delay.lua hold the
# tuned autoplay timings, which are the point of keeping a backup. Leave
# bot.api.key empty there, or move it to an untracked override, since it is a
# credential.

# ---------------------------------------------------------------------------
# OS / editor / tooling noise
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.log
*.tmp
*.orig
*.rej
*.bak

# ---------------------------------------------------------------------------
# Agent / assistant scratch
# ---------------------------------------------------------------------------
.claude
CLAUDE.md
claude*.md
AGENTS.md
agent*.md
.agents
.codex
.cursor/
.zcode/
*mcp.json
reference
reference*.md
